km = float(input("Введите расстояние (км):"))
kmh = float(input("Введите скорость (км/ч):"))
rashod = float(input("Введите расход топлива (л/100 км):"))
print(f'Маршрут: {km} км, скорость {kmh} км/ч')
print(f'Время в пути: {km / kmh:.2f} часов')
print(f'Расход топлива: {rashod} л/100 км')
print(f'Общий расход: {rashod * km / 100:.2f} литров')
